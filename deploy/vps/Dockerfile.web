# Vem Comer front door: builds the React app and serves it with Caddy (automatic HTTPS).
# Build context: repository root.
FROM node:22-alpine AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# The browser talks to the same address that served the page, under /api.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM caddy:2-alpine
COPY deploy/vps/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv/site
