# SITE_ADDRESS comes from the .env file (for example: meurestaurante.com.br).
# Caddy gets and renews the HTTPS certificate by itself. Ports 80 and 443 must be open.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=()"
		-Server
	}

	# Esta rota antiga (sem proteção nenhuma) fica fechada para sempre: o administrador cria
	# restaurantes pelo servidor (deploy/vps/criar-restaurante.sh). O cadastro pela internet usa
	# a rota nova /api/signup, que já vem protegida e fechada até abrir-cadastro.sh abrir.
	handle /api/auth/register-company* {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:5000
	}

	# Fotos dos pratos. Cada foto nova ganha um nome novo (sorteado), por isso pode ficar guardada
	# no celular do cliente "para sempre". Sem listagem de pasta; só entrega o arquivo pedido.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/site
		@casca path / /index.html
		header @casca Cache-Control "no-cache"
		@arquivos path /assets/*
		header @arquivos Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
