# Vem Comer API (Flask + gunicorn). Build context: repository root.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/backend

COPY backend/requirements.txt ./
RUN pip install -r requirements.txt

COPY backend/ ./

RUN useradd --system --no-create-home --shell /usr/sbin/nologin vemcomer \
    && chown -R vemcomer:vemcomer /app
USER vemcomer

EXPOSE 5000

# One worker with threads on purpose: the login limiter keeps its counters in memory,
# so a single process keeps the limit honest. Raise workers only after moving it to the database.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "8", "--timeout", "30", "--access-logfile", "-", "app:app"]
