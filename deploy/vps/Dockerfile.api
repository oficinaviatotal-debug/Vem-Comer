# Vem Comer API (Flask + gunicorn). Build context: repository root.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/backend

COPY backend/requirements.txt ./
RUN pip install -r requirements.txt

COPY backend/ ./

# /data/uploads guarda as fotos dos pratos. A pasta nasce da imagem com o dono certo; o volume
# do Docker herda isso na primeira vez que é criado.
RUN useradd --system --no-create-home --shell /usr/sbin/nologin vemcomer \
    && mkdir -p /data/uploads \
    && chown -R vemcomer:vemcomer /app /data
USER vemcomer

EXPOSE 5000

# No access log on purpose: URLs here carry ?tracking_token=..., which must not land in the logs.
# One worker with threads on purpose: the login limiter keeps its counters in memory,
# so a single process keeps the limit honest. Raise workers only after moving it to the database.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "8", "--timeout", "120", "app:app"]
